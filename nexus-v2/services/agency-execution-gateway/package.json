{
  "name": "agency-execution-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types && npm run typecheck && npm test",
    "types": "wrangler types worker-configuration.d.ts --env-interface ExecGatewayEnv --config wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "deploy:dry": "wrangler deploy --dry-run --config wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
