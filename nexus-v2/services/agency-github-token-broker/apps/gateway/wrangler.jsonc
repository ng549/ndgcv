{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agency-github-token-broker-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    {
      "binding": "BROKER_CORE",
      "service": "agency-github-token-broker-core"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
