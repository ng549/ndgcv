{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.internal/contracts/worker9-command-request.v1.json",
  "title": "Worker 9 command request consumed by Worker 13",
  "type": "object",
  "required": ["command","payload"],
  "properties": {
    "command": {
      "enum": ["RUN","CONTINUE","PAUSE","RESUME","STOP","RETRY"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-worker9-routes": {
    "list": "GET /api/workers",
    "worker_command": "POST /api/workers/:id/commands",
    "run_all_ready": "POST /api/run-all-ready",
    "run_phase": "POST /api/run-phase/:phase"
  }
}