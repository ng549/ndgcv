{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.internal/contracts/worker9-list-workers-response.v1.json",
  "title": "Worker 9 list-workers response consumed by Worker 13",
  "type": "object",
  "required": ["workers"],
  "properties": {
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "worker_id","phase","module","scope","branch",
          "budget_limit_micros","canonical_sha","state"
        ],
        "properties": {
          "worker_id": {"type":"string","minLength":1},
          "phase": {"type":"string","minLength":1},
          "module": {"type":"string","minLength":1},
          "scope": {"type":"string","minLength":1},
          "branch": {"type":"string","minLength":1},
          "preferred_model": {"type":["string","null"]},
          "budget_limit_micros": {"type":"integer","minimum":0},
          "budget_consumed_micros": {"type":"integer","minimum":0},
          "canonical_sha": {"type":"string","minLength":7},
          "state": {
            "enum": [
              "READY","RUNNING","PAUSED","STOPPED","WAITING_ON_DEPENDENCY",
              "BLOCKED","FAILED","NEEDS_REVIEW","COMPLETE"
            ]
          },
          "checkpoint_sha": {"type":["string","null"]},
          "heartbeat_at": {"type":["string","null"],"format":"date-time"},
          "blocker": {"type":["object","string","null"]},
          "review_state": {
            "enum": ["NOT_SENT","PENDING","APPROVED","REJECTED"],
            "description": "Optional; consumed for SEND_TO_REVIEW gating. Absent => treated as NOT_SENT by Worker 9 persistence default."
          },
          "packet_version": {"type":"integer","minimum":1},
          "active_execution_id": {"type":["string","null"]},
          "lease_expires_at": {"type":["string","null"],"format":"date-time"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}