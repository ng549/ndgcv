{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-v2-operator-command-center",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "vars": {
    "OPERATOR_EMAIL": "ng@moremarginco.com"
  },
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "nexus-v2-operator-audit",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "OPERATOR_RATE_LIMITER",
      "namespace_id": "13001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
