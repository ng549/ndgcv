{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/model-capability-manifest.schema.json",
  "title": "Nexus model and capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_id", "aggregator", "upstream_provider", "plan", "model_id", "capabilities", "commercial_status", "last_verified"],
  "properties": {
    "route_id": {"type": "string"},
    "aggregator": {"type": "string"},
    "upstream_provider": {"type": "string"},
    "plan": {"type": "string"},
    "model_id": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "context_tokens": {"type": ["integer", "null"], "minimum": 0},
    "modalities_in": {"type": "array", "items": {"type": "string"}},
    "modalities_out": {"type": "array", "items": {"type": "string"}},
    "tool_use": {"type": "boolean"},
    "structured_output": {"type": "boolean"},
    "batch": {"type": "boolean"},
    "pricing_ref": {"type": ["string", "null"]},
    "latency_class": {"enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
    "quality_class": {"enum": ["UTILITY", "GENERAL", "FRONTIER", "SPECIALIST", "UNBENCHMARKED"]},
    "availability": {"enum": ["HEALTHY", "DEGRADED", "DISABLED", "UNKNOWN"]},
    "commercial_status": {"enum": ["APPROVED_MONETIZABLE", "CONDITIONAL", "INTERNAL_ONLY", "REJECTED", "UNVERIFIED"]},
    "rights_record_id": {"type": ["string", "null"]},
    "privacy_profile_id": {"type": ["string", "null"]},
    "fallback_group": {"type": ["string", "null"]},
    "benchmark_refs": {"type": "array", "items": {"type": "string"}},
    "last_verified": {"type": "string", "format": "date-time"},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}}
  }
}
