{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/capability-bullpen.schema.json",
  "title": "Nexus capability bullpen",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability", "environment", "routes", "selection_policy_version", "last_verified"],
  "properties": {
    "capability": {"type": "string"}, "environment": {"enum": ["development", "customer"]},
    "routes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["route_id", "rank", "qualification_status"], "properties": {"route_id": {"type": "string"}, "rank": {"type": "integer", "minimum": 1}, "qualification_status": {"enum": ["UNVERIFIED", "QUALIFIED", "DEGRADED", "DISABLED"]}, "benchmark_ref": {"type": ["string", "null"]}, "service_level": {"type": ["string", "null"]}}}},
    "selection_policy_version": {"type": "string"}, "last_verified": {"type": "string", "format": "date-time"}
  }
}
