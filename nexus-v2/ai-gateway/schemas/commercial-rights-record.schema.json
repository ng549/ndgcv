{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/commercial-rights-record.schema.json",
  "title": "Nexus commercial rights record",
  "type": "object",
  "additionalProperties": false,
  "required": ["rights_record_id", "provider", "plan", "model", "intended_use", "status", "verification_date", "confidence", "source_urls", "legal_review_required"],
  "properties": {
    "rights_record_id": {"type": "string"},
    "provider": {"type": "string"},
    "plan": {"type": "string"},
    "model": {"type": "string"},
    "capability": {"type": "string"},
    "intended_use": {"type": "string"},
    "status": {"enum": ["APPROVED_MONETIZABLE", "CONDITIONAL", "INTERNAL_ONLY", "REJECTED", "UNVERIFIED"]},
    "customer_facing_app_permitted": {"type": ["boolean", "null"]},
    "output_commercial_use": {"type": ["boolean", "null"]},
    "raw_api_resale_permitted": {"type": ["boolean", "null"]},
    "white_label_permitted": {"type": ["boolean", "null"]},
    "standalone_resale_prohibited": {"type": ["boolean", "null"]},
    "end_user_terms_required": {"type": ["boolean", "null"]},
    "model_specific_terms": {"type": ["string", "null"]},
    "attribution": {"type": ["string", "null"]},
    "restricted_industries": {"type": "array", "items": {"type": "string"}},
    "training_use": {"type": ["string", "null"]},
    "retention": {"type": ["string", "null"]},
    "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "verification_date": {"type": "string", "format": "date"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "legal_review_required": {"type": "boolean"},
    "reviewer": {"type": ["string", "null"]}
  }
}
