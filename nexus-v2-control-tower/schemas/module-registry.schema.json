{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.moremarginco.com/schemas/module-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "status", "integration_branch", "merge_policy", "modules"],
  "properties": {
    "$schema": {"type": "string"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "accepted", "deprecated"]},
    "integration_branch": {"const": "nexus-v2"},
    "merge_policy": {"const": "control-tower-reconciliation-only"},
    "modules": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "owner", "branch", "starts", "depends_on", "owns", "non_goals"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "number": {"type": "integer", "minimum": 1, "maximum": 13},
          "owner": {"type": "string", "minLength": 1},
          "branch": {"type": "string", "pattern": "^nexus-v2-p1-[0-9]{2}-[a-z0-9-]+$"},
          "starts": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "owns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "non_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}

