{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.moremarginco.com/schemas/architecture-change-request.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["acr_id","title","status","requester","date","affected_modules","problem","proposed_change","alternatives","contract_impact","security_impact","cost_schedule_impact","migration","rollback","evidence","decision_owner"],
  "properties": {
    "acr_id":{"type":"string","pattern":"^ACR-[0-9]{4}$"},
    "title":{"type":"string","minLength":1},
    "status":{"enum":["proposed","researching","needs-review","accepted","rejected","superseded"]},
    "requester":{"type":"string","minLength":1},
    "date":{"type":"string","format":"date"},
    "affected_modules":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "problem":{"type":"string","minLength":1},
    "proposed_change":{"type":"string","minLength":1},
    "alternatives":{"type":"array","minItems":1,"items":{"type":"string"}},
    "contract_impact":{"type":"string","minLength":1},
    "security_impact":{"type":"string","minLength":1},
    "cost_schedule_impact":{"type":"string","minLength":1},
    "migration":{"type":"string","minLength":1},
    "rollback":{"type":"string","minLength":1},
    "evidence":{"type":"array","items":{"type":"string"}},
    "decision_owner":{"type":"string","minLength":1},
    "decision":{"type":["string","null"]}
  }
}

