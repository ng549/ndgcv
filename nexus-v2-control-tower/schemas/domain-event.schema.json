{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.moremarginco.com/schemas/domain-event.schema.json",
  "title": "Nexus CloudEvents 1.0 JSON Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion","id","source","type","time","datacontenttype","scope","actortype","actorid","dataclassification","correlationid","data"],
  "properties": {
    "specversion": {"const":"1.0"},
    "id": {"type":"string","minLength":16},
    "source": {"type":"string","format":"uri-reference","minLength":1},
    "type": {"type":"string","pattern":"^nexus\\.[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+\\.v[1-9][0-9]*$"},
    "subject": {"type":"string","minLength":1},
    "time": {"type":"string","format":"date-time","pattern":"Z$"},
    "datacontenttype": {"const":"application/json"},
    "dataschema": {"type":"string","format":"uri"},
    "scope": {"enum":["tenant","system"]},
    "tenantid": {"type":"string","minLength":1},
    "projectid": {"type":"string","minLength":1},
    "actortype": {"enum":["user","operator","service","worker","system"]},
    "actorid": {"type":"string","minLength":1},
    "dataclassification": {"enum":["public","internal","confidential","restricted"]},
    "correlationid": {"type":"string","minLength":1},
    "causationid": {"type":"string","minLength":1},
    "traceparent": {"type":"string","pattern":"^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
    "data": {"type":"object"}
  },
  "allOf": [
    {
      "if": {"properties":{"scope":{"const":"tenant"}},"required":["scope"]},
      "then": {"required":["tenantid"]},
      "else": {"not":{"required":["tenantid"]}}
    }
  ]
}
